{
  "name": "Elysia Dev",
  "dockerComposeFile": "./compose.yml",
  "service": "app",
  "workspaceFolder": "/app",
  "mounts": [
    {
      "type": "bind",
      "source": "..",
      "target": "/app"
    },
  ],
  "onCreateCommand": "rm -f /tmp/devcontainer-ready && bun install --frozen-lockfile && bun run src/server.ts migrate && touch /tmp/devcontainer-ready",
  "customizations": {
    "vscode": {
      "extensions": [
        "oven.bun-vscode"
      ]
    },
    "codespaces": {
      "extensions": [
        "oven.bun-vscode"
      ]
    }
  },
  "remoteUser": "root",
  "remoteEnv": {
    "APP_DOMAIN": "localhost",
    "APP_VERSION": "0.0.0-devcontainer",
    "NODE_ENV": "devcontainer"
  },
  "runServices": [
    "postgres",
    "mailpit",
    "jaeger"
  ]
}
